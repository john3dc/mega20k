// Nano 20K pins, matching NESTang 5b24a710 controller/SD/HDMI wiring.
IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC "button" 88;
IO_PORT "button" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "led_n" 15;
IO_PORT "led_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "snes_latch1" 28;
IO_LOC "snes_clock1" 27;
IO_LOC "snes_data1" 25;
IO_LOC "snes_latch2" 29;
IO_LOC "snes_clock2" 26;
IO_LOC "snes_data2" 30;
// Bank 5 also contains the HDMI clock pair. Set its actual board supply
// explicitly; otherwise the packer defaults the mixed LVDS bank to 2.5 V.
IO_PORT "snes_latch1" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "snes_clock1" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "snes_data1" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "snes_latch2" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "snes_clock2" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "snes_data2" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sd_clk" 83;
IO_LOC "sd_mosi" 82;
IO_LOC "sd_miso" 84;
IO_LOC "sd_cs_n" 81;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
// On-board configuration flash. RECONFIG_N keeps its configuration function.
IO_LOC "flash_clk" 59;
IO_LOC "flash_cs_n" 60;
IO_LOC "flash_mosi" 61;
IO_LOC "flash_miso" 62;
IO_LOC "flash_wp_n" 57;
IO_LOC "flash_hold_n" 63;
IO_LOC "reconfig_n" 9;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "flash_wp_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "flash_hold_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "reconfig_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "tmds_d_p[0]" 35;
IO_LOC "tmds_d_n[0]" 36;
IO_PORT "tmds_d_n[0]" IO_TYPE=LVDS25;
IO_LOC "tmds_d_p[1]" 37;
IO_LOC "tmds_d_n[1]" 38;
IO_PORT "tmds_d_n[1]" IO_TYPE=LVDS25;
IO_LOC "tmds_d_p[2]" 39;
IO_LOC "tmds_d_n[2]" 40;
IO_PORT "tmds_d_n[2]" IO_TYPE=LVDS25;
IO_LOC "tmds_clk_p" 33;
IO_LOC "tmds_clk_n" 34;
IO_PORT "tmds_clk_n" IO_TYPE=LVDS25;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25;
